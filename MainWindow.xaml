<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded_1">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label FontSize="32" Content="Filter" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <Label  FontSize="32" Content="Robot List" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>
        <Label  FontSize="32" Content="Robot Details" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>

        <RadioButton  FontSize="18" Content="ALL ROBOTS" Grid.Row="1" Grid.Column="0" Margin="10,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <RadioButton FontSize="18" Content="HOUSEHOLD" Grid.Row="2" Grid.Column="0" Margin="10,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <RadioButton FontSize="18" Content="DELIVERY" Grid.Row="3" Grid.Column="0" Margin="10,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <Image Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Source="/images/robot.png"  MinWidth="20"/>
        <Image Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Source="/images/household-robot.png" MinWidth="20"/>
        <Image Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right" Source="/images/delivery-robot.png" MinWidth="20"/>

        <ListBox Name="RobotsListBox" FontSize="14" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Margin="5, 5, 5, 5"/>
        <TextBlock FontSize="14" TextWrapping="Wrap" Text="TextBlock" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3" Margin="5, 5, 5, 5"/>

    </Grid>
</Window>
